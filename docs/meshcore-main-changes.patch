@@ -0,0 +1,7 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <stddef.h>
+namespace disaster {
+constexpr size_t ARCHIVE_LIMIT=1048576;
+inline bool archiveRotate(size_t size,size_t record){return size%record!=0||size+record>ARCHIVE_LIMIT;}
+}
diff --git workspace/DisasterMesh/firmware/MeshCore/examples/companion_radio/ArchiveSd.h workspace/DisasterMesh/firmware/MeshCore/examples/companion_radio/ArchiveSd.h
new file mode 100644
index 0000000..ce70a37
--- /dev/null
+++ workspace/DisasterMesh/firmware/MeshCore/examples/companion_radio/ArchiveSd.h
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "HistoryRecord.h"
+#include "ArchivePolicy.h"
+#ifdef DISASTER_SD
+#include <SD.h>
+#include <SPI.h>
+#include "ArchiveBusConfig.h"
+#endif
+class ArchiveSd {
+#ifdef DISASTER_SD
+ SPIClass bus{disaster::sdBus};
+#endif
+ bool mounted=false;
+public:
+ void begin(){
+#ifdef DISASTER_SD
+  bus.begin(disaster::sdSck,disaster::sdMiso,disaster::sdMosi,disaster::sdCs);
+  mounted=SD.begin(disaster::sdCs,bus,4000000,"/sd",2,false);
+  if(mounted&&!SD.exists("/disaster"))mounted=SD.mkdir("/disaster");
+  Serial.println(mounted?"SD archive ready":"SD archive unavailable; internal history remains active");
+#endif
+ }
+ bool ready()const{return mounted;}
+ void append(const disaster::HistoryRecord &r){
+#ifdef DISASTER_SD
+  if(!mounted)return;
+  auto f=SD.open("/disaster/current.bin",FILE_APPEND);
+  if(!f){mounted=false;return;}
+  size_t bytes=f.size();f.close();
+  if(bytes>disaster::ARCHIVE_LIMIT){mounted=false;return;}
+  // Preserve a torn tail in the previous segment; never append misaligned records.
+  bool rotate=disaster::archiveRotate(bytes,sizeof(r));
+  if(rotate){if(SD.exists("/disaster/previous.bin")&&!SD.remove("/disaster/previous.bin")){mounted=false;return;}
+   if(!SD.rename("/disaster/current.bin","/disaster/previous.bin")){mounted=false;return;}}
+  f=SD.open("/disaster/current.bin",FILE_APPEND);
+  if(!f||f.write((const uint8_t*)&r,sizeof(r))!=sizeof(r))mounted=false;
+  f.close();
+#else
+  (void)r;
+#endif
+ }
+ File open(bool previous){
+#ifdef DISASTER_SD
+  if(mounted){File f=SD.open(previous?"/disaster/previous.bin":"/disaster/current.bin",FILE_READ);if(f&&f.size()<=disaster::ARCHIVE_LIMIT)return f;f.close();}
+#else
+  (void)previous;
+#endif
+  return File();
+ }
+};
diff --git workspace/DisasterMesh/firmware/MeshCore/examples/companion_radio/DeliveryOutbox.h workspace/DisasterMesh/firmware/MeshCore/examples/companion_radio/DeliveryOutbox.h
new file mode 100644
index 0000000..b7a6033
--- /dev/null
+++ workspace/DisasterMesh/firmware/MeshCore/examples/companion_radio/DeliveryOutbox.h
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "OutboxRecord.h"
+#include <SPIFFS.h>
+class DeliveryOutbox {
+ disaster::OutboxRecord jobs[disaster::OUTBOX_SLOTS]{};
+ uint32_t due[disaster::OUTBOX_SLOTS]{},lastId=0,wall=0,wallMs=0;
+ bool clockReady=false,healthy=true;
+ bool persist(size_t i){
+  auto &r=jobs[i];++r.revision;r.crc=disaster::outboxChecksum(r);
+  File f=SPIFFS.open("/dr-outbox.bin","r+");
+  if(!f&&!SPIFFS.exists("/dr-outbox.bin"))f=SPIFFS.open("/dr-outbox.bin","w+");
+  bool ok=f&&f.seek(disaster::outboxOffset(i,r.revision))&&f.write((const uint8_t*)&r,sizeof(r))==sizeof(r);f.close();
+  disaster::OutboxRecord check{};f=SPIFFS.open("/dr-outbox.bin","r");
+  ok=ok&&f&&f.seek(disaster::outboxOffset(i,r.revision))&&f.read((uint8_t*)&check,sizeof(check))==sizeof(check)&&disaster::outboxValid(check)&&check.id==r.id&&check.revision==r.revision;
+  f.close();if(!ok)healthy=false;return ok;
+ }
+public:
+ void begin(){
+  File f=SPIFFS.open("/dr-outbox.bin","r");
+  for(size_t i=0;i<disaster::OUTBOX_SLOTS;++i){
+   for(unsigned copy=0;copy<2;++copy){disaster::OutboxRecord r{};
+    if(f&&f.seek((i*2+copy)*sizeof(r))&&f.read((uint8_t*)&r,sizeof(r))==sizeof(r)&&disaster::outboxValid(r)&&r.revision>jobs[i].revision)jobs[i]=r;
+   }
+   if(jobs[i].id>lastId)lastId=jobs[i].id;
+   due[i]=millis()+(jobs[i].attempts?300000:0);
+  }f.close();
+ }
+ void syncClock(uint32_t stamp){uint32_t current=now();wall=clockReady&&current>stamp?current:stamp;wallMs=millis();clockReady=true;}
+ uint32_t now()const{return clockReady?wall+(uint32_t)(millis()-wallMs)/1000:0;}
+ bool ready()const{return clockReady&&healthy;}
+ bool storageOK()const{return healthy;}
+ uint32_t latestStamp()const{uint32_t stamp=0;for(const auto &j:jobs)if(j.stamp>stamp)stamp=j.stamp;return stamp;}
+ const disaster::OutboxRecord &get(size_t i)const{return jobs[i];}
+ int enqueue(const uint8_t recipient[32],const char *text,uint32_t stamp,uint32_t expires){
+  if(!healthy)return -2;
+  int slot=-1;for(size_t i=0;i<disaster::OUTBOX_SLOTS;++i)if(!jobs[i].id){slot=i;break;}
+  if(slot<0)for(size_t i=0;i<disaster::OUTBOX_SLOTS;++i)if(jobs[i].state!=disaster::QUEUED&&(slot<0||jobs[i].id<jobs[slot].id))slot=i;
+  if(slot<0)return -1;
+  auto revision=jobs[slot].revision;disaster::OutboxRecord r{};r.revision=revision;r.id=++lastId;r.stamp=stamp;r.expires=expires;r.state=disaster::QUEUED;memcpy(r.recipient,recipient,32);strncpy(r.text,text,100);jobs[slot]=r;due[slot]=millis();
+  if(!persist(slot))return -2;
+  syncClock(stamp);return slot;
+ }
+ int next(){
+  if(!ready())return -1;
+  for(size_t i=0;i<disaster::OUTBOX_SLOTS;++i){auto &r=jobs[i];if(r.state!=disaster::QUEUED)continue;
+   if(now()>=r.expires){r.state=disaster::EXPIRED;persist(i);continue;}
+   if((int32_t)(millis()-due[i])<0)continue;
+   if(r.attempts>=4){r.state=disaster::UNCONFIRMED;persist(i);continue;}
+   return i;
+  }return -1;
+ }
+ // Attempt count must reach durable storage BEFORE handing a frame to the core.
+ bool start(size_t i){auto &r=jobs[i];if(!ready()||r.state!=disaster::QUEUED||r.attempts>=4)return false;++r.attempts;due[i]=millis()+disaster::retryDelay(r.attempts);return persist(i);}
+ void tag(size_t i,const uint8_t *tag){auto &r=jobs[i];if(r.attempts){memcpy(r.tags[r.attempts-1],tag,4);persist(i);}}
+ void acknowledge(const uint8_t *tag){
+  int match=-1;
+  for(size_t i=0;i<disaster::OUTBOX_SLOTS;++i)if(disaster::hasTag(jobs[i],tag)){if(match>=0)return;match=i;}
+  if(match>=0&&(jobs[match].state==disaster::QUEUED||jobs[match].state==disaster::UNCONFIRMED)){jobs[match].state=disaster::DELIVERED;persist(match);}
+ }
+ bool cancel(uint32_t id){for(size_t i=0;i<disaster::OUTBOX_SLOTS;++i)if(jobs[i].id==id&&jobs[i].state==disaster::QUEUED){jobs[i].state=disaster::CANCELLED;return persist(i);}return false;}
+ void defer(size_t i){due[i]=millis()+300000;}
+};
diff --git workspace/DisasterMesh/firmware/MeshCore/examples/companion_radio/DisasterPortal.h workspace/DisasterMesh/firmware/MeshCore/examples/companion_radio/DisasterPortal.h
new file mode 100644
index 0000000..d0e469d
--- /dev/null
+++ workspace/DisasterMesh/firmware/MeshCore/examples/companion_radio/DisasterPortal.h
@@ -0,0 +1,503 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#if defined(ENABLE_USB_INTERFACE) || defined(BLE_PIN_CODE) || defined(WIFI_SSID)
+#error "The local portal must own the Companion interface in this profile"
+#endif
+#if LORA_TX_POWER != 10
+#error "Unexpected portal default TX power"
+#endif
+#if defined(ENABLE_PRIVATE_KEY_EXPORT) || defined(ENABLE_PRIVATE_KEY_IMPORT)
+#error "Private key transfer must be disabled for the portal profile"
+#endif
+#include <helpers/BaseSerialInterface.h>
+#include <WebServer.h>
+#include <DNSServer.h>
+#include <WiFi.h>
+#include <Preferences.h>
+#include <SPIFFS.h>
+#include <esp_system.h>
+#include <esp_timer.h>
+#include "PortalPage.h"
+#include "PortalAssets.h"
+#include "AdminSession.h"
+#include <mbedtls/sha256.h>
+#include "HistoryRecord.h"
+#include "DeliveryOutbox.h"
+#include "ArchiveSd.h"
+
+// A single local companion owns the protocol. HTTP clients share its history.
+// Raw, arbitrary companion commands and private keys are never exposed to HTTP.
+class DisasterPortal : public BaseSerialInterface {
+  uint32_t txFlood=0, txDirect=0, rxFlood=0, rxDirect=0;
+  bool txBudgetWaiting=false;
+  bool gpsEnabled=false,gpsFix=false;double gpsLat=0,gpsLon=0;
+  uint32_t txBudgetWaitEvents=0, txBudgetWaitSeconds=0;
+  int txQueuePackets=0;
+  struct ClientBudget { char id[16]; uint32_t lastMs=0, windowStart=0; uint8_t count=0; bool used=false; };
+  ClientBudget clientBudgets[8]{};
+  unsigned long txAirMs=0, rxAirMs=0, txBudgetMs=0;
+  disaster::AdminSession admin;
+  String adminHash, adminSalt;
+  bool adminButtonHeld=false, adminButtonDone=false;
+  uint32_t adminButtonSince=0;
+  DeliveryOutbox delivery;
+  ArchiveSd archive;
+  int activeJob=-1;
+  uint32_t routeJob=0;uint8_t routeAttempt=255;
+  WebServer http{80};
+  String apPassword; bool apOk=false; unsigned long apRetry=0, apPrint=0;
+  DNSServer dns;
+  bool enabled = false, storageOK = true;
+  uint8_t startup = 0, active = 0;
+  uint32_t nextPoll = 0, seq = 0, lastSend = 0, lastStamp = 0;
+  bool sentOnce = false, userCommand = false;
+  uint8_t pending[MAX_FRAME_SIZE] = {}, pendingLen = 0;
+  uint8_t outgoing[MAX_FRAME_SIZE] = {}, outgoingLen = 0;
+  String info, contacts[64], channels[8], apName;
+  String roomTarget;
+  uint8_t roomRights=0, loginLen=0, loginFrame[49]={};
+  bool roomPending=false;
+  uint32_t roomSince=0;
+  // Reject ambiguous short identifiers instead of choosing an arbitrary contact.
+  const String *roomContact(const String &target) const {
+    if(target.length()!=13||target[0]!='d')return nullptr;
+    const String *found=nullptr;
+    for(const auto &c:contacts)if(c.length()>=264&&c.substring(2,14)==target.substring(1)&&c.substring(66,68)=="03"){
+      if(found)return nullptr;found=&c;
+    }
+    return found;
+  }
+  String outcome = "Bereit";
+  uint32_t activeSince = 0;
+  using Record = disaster::HistoryRecord;
+  static_assert(MAX_FRAME_SIZE == disaster::FRAME_BYTES, "Companion frame size changed");
+  static String hex(const uint8_t *p, size_t n) {
+    static const char digits[]="0123456789abcdef";
+    String out; out.reserve(n*2);
+    for(size_t i=0;i<n;++i){out+=digits[p[i]>>4];out+=digits[p[i]&15];}
+    return out;
+  }
+  void append(const uint8_t *p, size_t n) {
+    if (!n || n>MAX_FRAME_SIZE) return;
+    Record r{}; r.seq=++seq; r.len=n; memcpy(r.data,p,n); r.crc=disaster::checksum(r);
+    File f=SPIFFS.open("/dr-history.bin", "r+");
+    if (!f) f=SPIFFS.open("/dr-history.bin", "w+");
+    if (!f || !f.seek(disaster::offset(r.seq)) || f.write((uint8_t*)&r,sizeof(r))!=sizeof(r)) storageOK=false;
+    f.close();archive.append(r);
+  }
+  bool permitted() {
+    // Custom header prevents cross-origin form submissions; no CORS is enabled.
+    String host=http.hostHeader();
+    if (host!="192.168.4.1" && host!="192.168.4.1:80" && host!="disaster.radio") {
+      http.send(403,"text/plain","Unbekannter Host"); return false;
+    }
+    if(http.header("X-Disaster-Request")!="1") {
+      http.send(403,"text/plain","Lokale Anfrage erforderlich"); return false;
+    }
+    http.sendHeader("Cache-Control","no-store");
+    return true;
+  }
+  // One phone must not fill the channel. Missing or invalid ids share one bucket.
+  bool allowClientSend() {
+    String raw=http.header("X-Disaster-Client");
+    char key[16]; memset(key,'0',sizeof(key));
+    bool ok=raw.length()==16;
+    if(ok)for(int i=0;i<16;++i){char c=raw[i];if(!((c>='0'&&c<='9')||(c>='a'&&c<='f')))ok=false;}
+    if(ok)memcpy(key,raw.c_str(),16);
+    uint32_t now=millis(); int slot=-1, empty=-1, oldest=0;
+    for(int i=0;i<8;++i){
+      if(!clientBudgets[i].used){if(empty<0)empty=i;continue;}
+      if(memcmp(clientBudgets[i].id,key,16)==0){slot=i;break;}
+      if(uint32_t(now-clientBudgets[i].lastMs)>uint32_t(now-clientBudgets[oldest].lastMs))oldest=i;
+    }
+    if(slot<0){slot=empty>=0?empty:oldest;memcpy(clientBudgets[slot].id,key,16);clientBudgets[slot].used=true;clientBudgets[slot].count=0;clientBudgets[slot].windowStart=now;clientBudgets[slot].lastMs=0;}
+    ClientBudget &b=clientBudgets[slot];
+    if(b.lastMs&&uint32_t(now-b.lastMs)<15000){http.send(429,"text/plain","Dieses Handy muss 15 Sekunden warten");return false;}
+    if(!b.windowStart||uint32_t(now-b.windowStart)>=600000){b.windowStart=now;b.count=0;}
+    if(b.count>=6){http.send(429,"text/plain","Sendebudget dieses Handys erschoepft: 6 Nachrichten in 10 Minuten");return false;}
+    b.lastMs=now;b.count++;return true;
+  }
+  bool room() {
+    if (!permitted()) return false;
+    if(startup<12 || pendingLen || active || loginLen) {
+      http.send(409,"text/plain","Knoten beschaeftigt. Bitte erneut versuchen."); return false;
+    }
+    return true;
+  }
+  String passwordHash(const String& pass) {
+    String salted=adminSalt+pass;uint8_t out[32];
+    mbedtls_sha256_ret((const unsigned char*)salted.c_str(),salted.length(),out,0);
+    return hex(out,sizeof(out));
+  }
+  void resetAdminPassword() {
+    uint8_t rnd[16];esp_fill_random(rnd,sizeof(rnd));String pass=hex(rnd,sizeof(rnd));
+    String next=passwordHash(pass);Preferences prefs;
+    if(!prefs.begin("disaster",false))return;
+    bool saved=prefs.putString("admin-hash",next)==next.length();prefs.end();
+    if(saved){adminHash=next;admin.clear();Serial.printf("\nNEUES ADMIN-PASSWORT: %s\n",pass.c_str());}
+  }
+  bool adminAllowed() {
+    if(!permitted())return false;
+    if(!admin.valid(http.header("X-Disaster-Admin").c_str(),millis())) {
+      http.send(401,"text/plain","Adminanmeldung erforderlich oder Sitzung abgelaufen");return false;
+    }
+    return true;
+  }
+  bool adminRoom() { return adminAllowed() && room(); }
+  void accept(const uint8_t *p,size_t n) {
+    memcpy(pending,p,n); pendingLen=n;
+    http.send(202,"text/plain","In Warteschlange; noch keine Zustellbestaetigung.");
+  }
+  void history() {
+    if(!permitted()) return;
+    http.setContentLength(CONTENT_LENGTH_UNKNOWN); http.send(200,"text/plain","");
+    // Physical slot order; client sorts by monotonically increasing sequence.
+    File f=SPIFFS.open("/dr-history.bin","r"); Record r;
+    while(f && f.read((uint8_t*)&r,sizeof(r))==sizeof(r)) {
+      if(disaster::valid(r))
+        http.sendContent(String(r.seq)+":"+hex(r.data,r.len)+"\n");
+    }
+    f.close(); http.sendContent("");
+  }
+  static bool hasNull(const String &s) {
+    for(size_t i=0;i<s.length();++i)if(s[i]==0)return true;
+    return false;
+  }
+  static int nibble(char c) {
+    if(c>='0'&&c<='9')return c-'0';
+    if(c>='a'&&c<='f')return c-'a'+10;
+    if(c>='A'&&c<='F')return c-'A'+10;
+    return -1;
+  }
+public:
+  // Snapshot existing MeshCore counters; does not issue Companion commands.
+  void setGps(bool enabled,bool fix,double lat,double lon){gpsEnabled=enabled;gpsFix=fix&&(lat!=0||lon!=0);gpsLat=lat;gpsLon=lon;}
+  void setRadioDiagnostics(uint32_t tf, uint32_t td, uint32_t rf, uint32_t rd,
+                           unsigned long ta, unsigned long ra, unsigned long budget,
+                           bool waiting, uint32_t events, uint32_t seconds, int queued) {
+    txFlood=tf;txDirect=td;rxFlood=rf;rxDirect=rd;
+    txAirMs=ta;rxAirMs=ra;txBudgetMs=budget;
+    txBudgetWaiting=waiting;txBudgetWaitEvents=events;txBudgetWaitSeconds=seconds;txQueuePackets=queued;
+  }
+  void begin() {
+    delivery.begin();lastStamp=delivery.latestStamp();archive.begin();
+    File f=SPIFFS.open("/dr-history.bin","r"); Record r;
+    while(f && f.read((uint8_t*)&r,sizeof(r))==sizeof(r))
+      if(disaster::valid(r) && r.seq>seq) seq=r.seq;
+    f.close();
+#ifdef PIN_USER_BTN
+    pinMode(PIN_USER_BTN, INPUT_PULLUP);
+#endif
+    Preferences prefs; prefs.begin("disaster",false);
+    String password=prefs.getString("ap-pass","");
+    if(password.length()<12) {
+      uint8_t random[8]; esp_fill_random(random,sizeof(random)); password=hex(random,sizeof(random));
+      prefs.putString("ap-pass",password);
+    }
+    adminSalt=prefs.getString("admin-salt", "");
+    adminHash=prefs.getString("admin-hash", "");
+    if(adminHash.length()!=64||adminSalt.length()!=32) {
+      uint8_t rnd[16];esp_fill_random(rnd,sizeof(rnd));adminSalt=hex(rnd,sizeof(rnd));
+      esp_fill_random(rnd,sizeof(rnd));String firstPassword=hex(rnd,sizeof(rnd));
+      adminHash=passwordHash(firstPassword);
+      prefs.putString("admin-salt",adminSalt);prefs.putString("admin-hash",adminHash);
+      Serial.printf("\nADMIN-PASSWORT (nur lokal aufbewahren): %s\n",firstPassword.c_str());
+    }
+    prefs.end();
+    uint64_t mac=ESP.getEfuseMac(); char suffix[7]; snprintf(suffix,sizeof(suffix),"%06X",(unsigned)(mac&0xffffff));
+    apName=String("DisAHRsterRadio-")+suffix;
+    apPassword=password;
+    WiFi.mode(WIFI_AP); WiFi.setSleep(false);
+#ifdef DISASTER_WIFI_TX
+    WiFi.setTxPower(DISASTER_WIFI_TX); Serial.println("[WLAN] reduzierte Sendeleistung"); Serial.flush(); delay(200);
+#endif
+    apOk=startAP();
